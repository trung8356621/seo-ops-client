{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "AI Center Routing / Model-Switch",
    "quality_profile": "showcase",
    "locale": "en",
    "output": "docs/architecture/ai-routing.workflow.html"
  },
  "lanes": [
    { "id": "select", "label": "Candidates + UI read-model" },
    { "id": "preflight", "label": "PRE-FLIGHT capacity + balance", "variant": "exception" },
    { "id": "run", "label": "Execute + POST-RESPONSE", "variant": "exception" }
  ],
  "phases": [
    { "id": "context", "label": "Context", "fromCol": 0, "toCol": 1 },
    { "id": "gate", "label": "Order + capacity", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "call", "label": "Usable · call · terminal", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": [
    "request",
    "ctx",
    "ordered",
    "capacity",
    "usable",
    "executor",
    "normalizer"
  ],
  "nodes": [
    {
      "id": "request",
      "lane": "select",
      "col": 0,
      "type": "frontend",
      "label": "AI Request",
      "width": 108
    },
    {
      "id": "ctx",
      "lane": "select",
      "col": 1,
      "type": "backend",
      "label": "Routing Context",
      "sublabel": "profile · FreeOnly",
      "width": 120
    },
    {
      "id": "ordered",
      "lane": "select",
      "col": 2,
      "type": "backend",
      "label": "Ordered candidates",
      "sublabel": "discover · manual",
      "tag": "manual order",
      "width": 136
    },
    {
      "id": "status",
      "lane": "select",
      "col": 3,
      "type": "frontend",
      "label": "AiCapacityStatusService",
      "sublabel": "UI/Rescue · not route auth",
      "width": 156
    },
    {
      "id": "bal-src",
      "lane": "preflight",
      "col": 1,
      "type": "external",
      "label": "Provider balance",
      "sublabel": "wallet source",
      "width": 112
    },
    {
      "id": "bal-cache",
      "lane": "preflight",
      "col": 2,
      "type": "database",
      "label": "BalanceSnapshotCache",
      "sublabel": "TTL 300s · known USD",
      "width": 140
    },
    {
      "id": "capacity",
      "lane": "preflight",
      "col": 3,
      "type": "security",
      "label": "AiRouteCapacityPolicy",
      "sublabel": "floor · budget · stub",
      "tag": "PRE-FLIGHT",
      "width": 148
    },
    {
      "id": "usable",
      "lane": "run",
      "col": 3,
      "type": "backend",
      "label": "First usable + shape",
      "sublabel": "FREE→SPLIT · PAID→SINGLE",
      "tag": "shape SSOT",
      "width": 136
    },
    {
      "id": "executor",
      "lane": "run",
      "col": 4,
      "type": "cloud",
      "label": "Provider Executor",
      "width": 116
    },
    {
      "id": "normalizer",
      "lane": "run",
      "col": 5,
      "type": "security",
      "label": "TerminalReasonNormalizer",
      "sublabel": "ok · retry · failover · lock",
      "tag": "POST-RESPONSE",
      "width": 164
    }
  ],
  "edges": [
    { "id": "e-request-ctx", "from": "request", "to": "ctx", "variant": "emphasis" },
    { "id": "e-ctx-ordered", "from": "ctx", "to": "ordered", "variant": "emphasis" },
    {
      "id": "e-ordered-capacity",
      "from": "ordered",
      "to": "capacity",
      "label": "manual order kept",
      "variant": "emphasis"
    },
    {
      "id": "e-capacity-usable",
      "from": "capacity",
      "to": "usable",
      "label": "eligible only",
      "variant": "security"
    },
    { "id": "e-usable-executor", "from": "usable", "to": "executor", "variant": "emphasis" },
    {
      "id": "e-executor-normalizer",
      "from": "executor",
      "to": "normalizer",
      "label": "raw finish/stop",
      "variant": "emphasis"
    },
    {
      "id": "e-bal-src-cache",
      "from": "bal-src",
      "to": "bal-cache",
      "label": "snapshot",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-cache-capacity",
      "from": "bal-cache",
      "to": "capacity",
      "label": "fresh+known+USD",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-ordered-status",
      "from": "ordered",
      "to": "status",
      "label": "read-model",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-trunc-failover",
      "from": "normalizer",
      "to": "ordered",
      "label": "OUTPUT_TRUNCATED → prefer paid",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "e-budget-suppress",
      "from": "normalizer",
      "to": "capacity",
      "label": "InsufficientBudget → profile",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "ROUTING INVARIANTS",
      "items": [
        "Manual order; eligibility excludes never reorders · Capacity pre-exec · Shape = first ACTUALLY usable · Outline≠Content shape · Unknown balance never invented · Terminal post-response · StatusService=UI only · KnownOutputCapacity=STUB · $1 longform floor profile-scoped · OUTPUT_TRUNCATED→prefer paid · BillingExhausted→paid lock"
      ]
    }
  ]
}
