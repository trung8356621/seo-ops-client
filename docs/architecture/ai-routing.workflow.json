  "edges": [
    { "id": "launch-bulk", "from": "launch", "to": "ep-bulk", "variant": "emphasis" },
    { "id": "bulk-handlers", "from": "ep-bulk", "to": "handlers", "variant": "emphasis" },
    { "id": "alt-handlers", "from": "ep-alt", "to": "handlers", "variant": "dashed", "role": "branch" },
    { "id": "handlers-snapshot", "from": "handlers", "to": "snapshot", "variant": "emphasis" },
    { "id": "snapshot-shape", "from": "snapshot", "to": "shape-plan", "label": "first usable", "variant": "emphasis" },
    { "id": "shape-attempt", "from": "shape-plan", "to": "attempt", "variant": "emphasis" },
    { "id": "attempt-history", "from": "attempt", "to": "history", "label": "record", "variant": "emphasis" },
    { "id": "attempt-fail", "from": "attempt", "to": "fail-health", "variant": "security", "role": "error" },
    { "id": "fail-history", "from": "fail-health", "to": "history", "label": "skip|402", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Routing Contract / Regression Hotspots",
      "items": [
        "OPERATIONAL_KEYS + startRun fallback: ai_cost_policy must survive Bulk/Relation stamps and Rerun/Resume gaps",
        "orderCandidates identity; GenerationShapeResolver FREE→SPLIT / PAID→SINGLE; planner phases ≠ order",
        "Entry diffs: Bulk/View/Relation stamp; View Rerun/Resume/step often fallback; history via PromptExecutionPersistence"
      ]
    }
  ]
}
