{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run build:all",
        "build:all": "npm run build:core && npm run build:editor && npm run build:media && npm run build:seo && npm run build:search && npm run build:projects && npm run build:support && npm run build:agent",
        "build:core": "vite build",
        "build:editor": "vite build --config vite.article-editor.config.js",
        "build:media": "vite build --config vite.media.config.js",
        "build:seo": "vite build --config vite.seo.config.js",
        "build:search": "vite build --config vite.search-intelligence.config.js",
        "build:projects": "vite build --config vite.content-projects.config.js",
        "build:support": "vite build --config vite.support.config.js",
        "build:agent": "vite build --config vite.agent.config.js",
        "dev:seeding": "npm --prefix addons/seeding run dev",
        "build:seeding": "npm --prefix addons/seeding run build",
        "dev:topical-map": "npm --prefix addons/search-intelligence run dev",
        "build:topical-map": "npm --prefix addons/search-intelligence run build",
        "check:editor-cycles": "node addons/content/scripts/check-editor-cycles.cjs",
        "check:editor-widget-locks": "node addons/content/scripts/check-editor-widget-locks.cjs",
        "widget-lock": "node addons/content/scripts/widget-lock.cjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "laravel-vite-plugin": "^1.2.0",
        "tailwindcss": "^4.0.0",
        "vite": "^6.0.7"
    },
    "dependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "@tiptap/extension-color": "^3.23.4",
        "@tiptap/extension-highlight": "^3.23.4",
        "@tiptap/extension-image": "^3.23.4",
        "@tiptap/extension-link": "^3.23.4",
        "@tiptap/extension-subscript": "^3.23.4",
        "@tiptap/extension-superscript": "^3.23.4",
        "@tiptap/extension-table": "^3.23.4",
        "@tiptap/extension-table-cell": "^3.23.4",
        "@tiptap/extension-table-header": "^3.23.4",
        "@tiptap/extension-table-row": "^3.23.4",
        "@tiptap/extension-text-align": "^3.23.4",
        "@tiptap/extension-text-style": "^3.23.4",
        "@tiptap/extension-underline": "^3.23.4",
        "@tiptap/pm": "^3.23.4",
        "@tiptap/react": "^3.23.4",
        "@tiptap/starter-kit": "^3.23.4",
        "apexcharts": "^5.16.0",
        "echarts": "^5.6.0",
        "lucide-react": "^1.16.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    }
}
